{
  "name": "Pings",
  "author": "Antidot",
  "description": "Adds a ping system to Raft, allowing players to mark locations or items of interest. Mod \"Extra Settings API\" (by Aidanamite) gives ability to change ping keybinds and duration.",
  "version": "3.0",
  "license": "GNU AGPLv3",
  "icon": "icon.jpg",
  "banner": "banner.jpg",
  "gameVersion": "1.0",
  "requiredByAllPlayers": false,
  "updateUrl": "https://www.raftmodding.com/api/v1/mods/pings/version.txt",
  "isModPermanent": false,
  "excludedFiles": [],
  "modSettings": [
    {
      "type": "keybind",
      "name": "pingKeybind",
      "text": "Ping Keybind",
      "mainDefault": "Mouse2"
    },
    {
      "type": "keybind",
      "name": "clearPingsKeybind",
      "text": "Clear All Existing Pings Keybind"
    },
    {
      "type": "slider",
      "name": "pingDuration",
      "text": "Ping Duration",
      "default": 10,
      "range": {
        "min": 0,
        "max": 14,
        "decimals": 7,
        "type": "custom"
      }
    },
    {
      "type": "slider",
      "name": "maxPingsPerPlayer",
      "text": "Maximum amount of pings per player",
      "default": 1,
      "range": {
        "min": 1,
        "max": 11,
        "decimals": 0,
        "type": "custom"
      }
    },
    {
      "type": "seperator",
      "section": "section-debug"
    },
    {
      "type": "combobox",
      "name": "debugMode",
      "text": "Debug Logging Level In Console",
      "default": "Disabled",
      "values": [
        "Disabled",
        "Normal",
        "Detailed"
      ]
    }
  ]
}