{
  "name": "Pings",
  "author": "Antidot",
  "description": "Adds a ping system to Raft, allowing players to mark locations or items of interest. Mod \"Extra Settings API\" (by Aidanamite) allows to change ping keybinds, duration, color and other things.",
  "version": "3.4",
  "license": "GNU AGPLv3",
  "icon": "icon.jpg",
  "banner": "banner.jpg",
  "gameVersion": "1.0",
  "requiredByAllPlayers": false,
  "updateUrl": "https://www.raftmodding.com/api/v1/mods/pings/version.txt",
  "isModPermanent": false,
  "excludedFiles": [],
  "modSettings": [
    {
      "type": "text",
      "text": "--- General"
    },
    {
      "type": "seperator",
      "section": "section-general"
    },
    
    {
      "type": "keybind",
      "name": "pingKeybind",
      "text": "Keybind to ping",
      "mainDefault": "Mouse2",
      "member": "PingKey"
    },
    {
      "type": "keybind",
      "name": "removeClosestPingKeybind",
      "text": "Keybind to remove closest to cursor ping",
      "member": "RemoveClosestPingKey"
    },
    {
      "type": "keybind",
      "name": "clearPingsKeybind",
      "text": "Keybind to clear all existing pings",
      "member": "RemoveAllPingsKey"
    },
    {
      "type": "slider",
      "name": "pingDuration",
      "text": "Ping Duration",
      "default": 7,
      "range": {
        "min": 0,
        "max": 14,
        "decimals": 0,
        "type": "custom"
      },
      "member": "PingDuration"
    },
    {
      "type": "slider",
      "name": "maxPingsPerPlayer",
      "text": "Maximum amount of pings per player",
      "default": 1,
      "range": {
        "min": 1,
        "max": 11,
        "decimals": 0,
        "type": "custom"
      },
      "member": "MaxPingsPerPlayer"
    },
    {
      "type": "seperator",
      "section": "section-general-end"
    },
    
    
    
    {
      "type": "text",
      "name": "visual",
      "text": "--- Visual"
    },
    {
      "type": "seperator",
      "section": "section-visual"
    },

    {
      "type": "combobox",
      "name": "outlineStyle",
      "text": "Outline Style",
      "values": [ "Disabled", "Quick", "Fancy" ],
      "default": "Fancy",
      "member": "Style"
    },

    {
      "type": "checkbox",
      "name": "uniquePingColors",
      "access": "globalcustom",
      "text": "Use unique colors for different players' pings",
      "default": false,
      "member": "UniquePingColors"
    },
    {
      "type": "input",
      "name": "colorDefault",
      "access": "globalcustom",
      "mode": "custom",
      "text": "Ping color",
      "default": "[<color=#FFEE22>▐█▌</color>] #FFEE22<color=#816f49></color>",
      "resetButton": true,
      "tooltip": [
        "Accepts hex color codes as '#RRGGBB' or '#RGB',",
        "where R, G and B are hexadecimal digits (0-9 and A-F)."
      ]
    },
    
    {
      "type": "checkbox",
      "name": "separateOwnPingColor",
      "access": "globalcustom",
      "text": "Use separate color for own pings",
      "default": false,
      "member": "HasOwnPingColor"
    },
    {
      "type": "input",
      "name": "colorOwn",
      "access": "globalcustom",
      "mode": "custom",
      "text": "Own ping color",
      "default": "[<color=#AAAAAA>▐█▌</color>] #AAA<color=#816f49>___</color>",
      "resetButton": true,
      "tooltip": [
        "Accepts hex color codes as '#RRGGBB' or '#RGB',",
        "where R, G and B are hexadecimal digits (0-9 and A-F)."
      ]
    },

    {
      "type": "slider",
      "name": "outlineThickness",
      "access": "globalcustom",
      "text": "Outline Thickness",
      "default": 1,
      "range": {
        "min": 0.1,
        "max": 5,
        "decimals": 0,
        "type": "percent"
      },
      "member": "OutlineThicknessMultiplier"
    },

    {
      "type": "checkbox",
      "name": "showEdgePingAsArrow",
      "section": "visual",
      "text": "Show pings on edge of screen as arrow",
      "default": true,
      "member": "ShowEdgePingAsArrow"
    },
    
    
    
    {
      "type": "seperator",
      "section": "section-debug"
    },
    
    {
      "type": "combobox",
      "name": "debugMode",
      "text": "--- Debug",
      "default": "Disabled",
      "values": [
        "Disabled",
        "Normal",
        "Detailed"
      ],
      "member": "DebugMode"
    }
  ]
}