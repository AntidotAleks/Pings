{
  "name": "Pings",
  "author": "Antidot",
  "description": "Adds a ping system to Raft, allowing players to mark locations or items of interest. Mod \"Extra Settings API\" (by Aidanamite) allows to change ping keybinds, duration and other things.",
  "version": "3.2",
  "license": "GNU AGPLv3",
  "icon": "icon.jpg",
  "banner": "banner.jpg",
  "gameVersion": "1.0",
  "requiredByAllPlayers": false,
  "updateUrl": "https://www.raftmodding.com/api/v1/mods/pings/version.txt",
  "isModPermanent": false,
  "excludedFiles": [],
  "modSettings": [
    {
      "type": "text",
      "text": "--- General"
    },
    {
      "type": "seperator",
      "section": "section-general"
    },
    
    {
      "type": "keybind",
      "name": "pingKeybind",
      "text": "Keybind to ping",
      "mainDefault": "Mouse2"
    },
    {
      "type": "keybind",
      "name": "removeClosestPingKeybind",
      "text": "Keybind to remove closest to cursor ping"
    },
    {
      "type": "keybind",
      "name": "clearPingsKeybind",
      "text": "Keybind to clear all existing pings"
    },
    {
      "type": "slider",
      "name": "pingDuration",
      "text": "Ping Duration",
      "default": 7,
      "range": {
        "min": 0,
        "max": 14,
        "decimals": 0,
        "type": "custom"
      }
    },
    {
      "type": "slider",
      "name": "maxPingsPerPlayer",
      "text": "Maximum amount of pings per player",
      "default": 1,
      "range": {
        "min": 1,
        "max": 11,
        "decimals": 0,
        "type": "custom"
      }
    },
    {
      "type": "seperator",
      "section": "section-general-end"
    },
    
    
    
    {
      "type": "text",
      "name": "visual",
      "text": "--- Visual"
    },
    {
      "type": "seperator",
      "section": "section-visual"
    },
    
    {
      "type": "checkbox",
      "name": "showEdgePingAsArrow",
      "section": "visual",
      "text": "Show pings on edge of screen as arrow",
      "default": true
    },
    
    
    
    {
      "type": "seperator",
      "section": "section-debug"
    },
    
    {
      "type": "combobox",
      "name": "debugMode",
      "text": "--- Debug",
      "default": "Disabled",
      "values": [
        "Disabled",
        "Normal",
        "Detailed"
      ]
    }
  ]
}